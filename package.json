{
  "name": "metro-is-just-a-bus",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend/core-api",
    "backend/validation-service",
    "backend/notification-service"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:core": "npm run dev --workspace backend/core-api",
    "dev:validation": "npm run dev --workspace backend/validation-service",
    "dev:notifications": "npm run dev --workspace backend/notification-service",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint frontend backend scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
